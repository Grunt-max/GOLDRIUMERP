<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <application android:allowBackup="false" android:usesCleartextTraffic="false" android:enableOnBackInvokedCallback="true" android:icon="@drawable/ic_launcher" android:label="골드리움 킹" android:theme="@style/AppTheme">
        <receiver android:name=".DailyActivityWidget" android:exported="false" android:label="골드리움 당일행적">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/daily_activity_widget_info" />
        </receiver>
        <provider android:name="androidx.core.content.FileProvider" android:authorities="kr.co.goldrium.king.files" android:exported="false" android:grantUriPermissions="true"><meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" /></provider>
        <activity android:name=".MainActivity" android:exported="true" android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
