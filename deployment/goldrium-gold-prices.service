[Unit]
Description=Goldrium ERP gold price collection
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=goldrium
Group=goldrium
WorkingDirectory=/srv/goldrium/app
EnvironmentFile=/etc/goldrium-erp.env
ExecStart=/srv/goldrium/venv/bin/python manage.py collect_gold_prices

[Install]
WantedBy=multi-user.target
